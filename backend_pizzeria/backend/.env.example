# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a un repositorio (ya está en .gitignore).

# --- Servidor ---
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=il_capo_della_pizza

# --- Autenticación (JWT) ---
# Genera una cadena aleatoria larga y secreta, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# --- Correo para recuperación de contraseña (SMTP) ---
# Puedes usar Gmail (con una "contraseña de aplicación"), SendGrid, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
SMTP_FROM="Il Capo della Pizza <no-reply@ilcapodellapizza.com.co>"

# --- Pasarela de pago (Wompi Colombia) ---
# Consíguelas en tu panel de comercio de Wompi: https://comercios.wompi.co
# Usa las llaves que empiezan con "_test_" mientras pruebas (sandbox);
# cámbialas por las de "_prod_" solo cuando estés listo para cobrar de verdad.
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=stagtest_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=stagtest_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
